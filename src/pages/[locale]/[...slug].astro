---
/**
 * Unified route for non-default-locale pages: /[locale]/[...slug]
 *
 * Handles:
 *   - /[locale]/[category]            → list page (slug.length === 1)
 *   - /[locale]/[category]/[slug]     → article detail (slug.length > 1)
 *
 * English (default locale, no prefix) is handled by src/pages/[...slug].astro.
 */
import ListPage from '~/components/article/ListPage.astro';
import ArticlePage from '~/components/article/ArticlePage.astro';
import { CONTENT_TYPES } from '~/config/navigation';
import { isLocale, defaultLocale, locales, type Locale } from '~/i18n/routing';
import { getEntryWithFallback, localesForEntry, parseEntryId, type ResolvedEntry } from '~/lib/content';
import { detailPath, languageAlternates, listPath } from '~/lib/url';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  let all: Awaited<ReturnType<typeof getCollection>> = [];
  try {
    all = await getCollection('wiki');
  } catch {
    // A newly initialized template has no MDX entries yet.
  }

  const paths: Array<{
    params: { locale: string; slug: string };
  }> = [];

  // Only non-default locales here.
  // `locales` is a module-level export (visible inside getStaticPaths,
  // unlike same-file top-level const — see AGENTS.md Astro 5 gotcha #3).
  const nonDefaultLocales = locales.filter((l) => l !== defaultLocale);

  for (const locale of nonDefaultLocales) {
    for (const contentType of CONTENT_TYPES) {
      paths.push({ params: { locale, slug: contentType } });
    }

    // Article paths from this locale's own MDX.
    for (const entry of all) {
      const parsed = parseEntryId(entry.id);
      if (!parsed || parsed.locale !== locale) continue;
      const articleSlug = parsed.slug === '10-update' ? '1.0-update' : parsed.slug;
      const publicSlug = parsed.category === 'guides' ? articleSlug : `${parsed.category}/${articleSlug}`;
      paths.push({ params: { locale, slug: publicSlug } });
    }

    // Keep English fallback URLs reachable for existing links, but the page
    // renderer marks them noindex when no translation exists.
    for (const entry of all) {
      const parsed = parseEntryId(entry.id);
      if (!parsed || parsed.locale !== defaultLocale) continue;
      const articleSlug = parsed.slug === '10-update' ? '1.0-update' : parsed.slug;
      const publicSlug = parsed.category === 'guides' ? articleSlug : `${parsed.category}/${articleSlug}`;
      const exists = paths.some((p) => p.params.locale === locale && p.params.slug === publicSlug);
      if (!exists) paths.push({ params: { locale, slug: publicSlug } });
    }

  }

  return paths;
}

interface Props {
  locale: string;
  slug: string;
}

const localeParam = Astro.params.locale;
const slug = Astro.params.slug;
if (!isLocale(localeParam) || localeParam === defaultLocale || !slug) {
  return new Response('Not Found', { status: 404 });
}
const locale: Locale = localeParam;
const parts = slug.split('/').filter(Boolean);

// Decide what to render based on slug length.
let view: 'list' | 'article' | 'not-found' = 'not-found';
let category = '';
let resolved: ResolvedEntry | null = null;

let articleSlug = '';

if (parts.length === 1 && CONTENT_TYPES.includes(parts[0])) {
  category = parts[0];
  view = 'list';
} else if (parts.length === 1) {
  category = 'guides';
  articleSlug = parts[0];
  resolved = await getEntryWithFallback(category, articleSlug === '1.0-update' ? '10-update' : articleSlug, locale);
  view = resolved ? 'article' : 'not-found';
} else {
  category = parts[0];
  articleSlug = parts.slice(1).join('/');
  if (CONTENT_TYPES.includes(category)) {
    resolved = await getEntryWithFallback(category, articleSlug === '1.0-update' ? '10-update' : articleSlug, locale);
    view = resolved ? 'article' : 'not-found';
  }
}

if (view === 'not-found') {
  return new Response('Not Found', { status: 404 });
}

const alternateLocales = view === 'list' ? locales : await localesForEntry(category, articleSlug);
const alternates = languageAlternates(
  (loc) => (view === 'list' ? listPath(category, loc) : detailPath(category, articleSlug, loc)),
  alternateLocales,
);
const localizedArticle = view === 'article' && resolved ? resolved.servedLocale === locale : true;
---

{view === 'list' && <ListPage locale={locale} category={category} alternates={alternates} />}
{view === 'article' && resolved && (
  <ArticlePage locale={locale} resolved={resolved} alternates={alternates} noindex={!localizedArticle} />
)}
