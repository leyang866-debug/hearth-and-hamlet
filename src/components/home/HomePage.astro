---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { detailPath, localizePath } from '~/lib/url';

interface Props { locale: Locale; jsonLd?: Record<string, unknown>[]; alternates?: Array<{ hreflang: string; href: string }>; }

const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home as any;
const hero = home.hero;
const meta = home.meta ?? { title: site.name, description: site.description };
const recent = await getRecentEntries(locale, 4);
const archiveTopics = [
  { title: 'Settlement basics', detail: 'Food, timber, workers, and the first camp upgrades.', href: '/beginner-guide', icon: 'lucide:tent-tree' },
  { title: 'Buildings directory', detail: 'Plan production, utility, and specialist buildings.', href: '/buildings', icon: 'lucide:building-2' },
  { title: 'Research & magic', detail: 'Read the systems that expand a growing settlement.', href: '/game-overview', icon: 'lucide:sparkles' },
  { title: 'Demo & release', detail: 'Check platforms, release notes, and current sources.', href: '/demo', icon: 'lucide:calendar-days' },
];
const showcaseCards = [
  { title: 'Settlements', description: 'Turn your first campfire into a reliable frontier home.', image: '/images/settlement.jpg', href: '/beginner-guide' },
  { title: 'Buildings', description: 'Choose structures that unlock your next useful decision.', image: '/images/buildings.jpg', href: '/buildings' },
  { title: 'Workers', description: 'Balance roles, resources, and the pace of expansion.', image: '/images/workers.jpg', href: '/game-overview' },
  { title: 'Magic', description: 'Trace research, alchemy, and the magical side of the hamlet.', image: '/images/magic.jpg', href: '/buildings/magic-academy' },
];
---

<LocaleLayout locale={locale} title={meta.title} titleSuffix="" description={meta.description} jsonLd={jsonLd} alternates={alternates}>
  <div class="relative -mx-4 -mt-8 overflow-hidden bg-background pb-16">
    <aside aria-hidden="true" class="home-rail pointer-events-none absolute bottom-0 left-0 top-0 hidden w-20 xl:flex xl:flex-col xl:items-center xl:gap-10 xl:pt-8">
      <Icon name="lucide:flame" class="h-5 w-5 text-nav-light" /><Icon name="lucide:tent-tree" class="h-4 w-4" /><Icon name="lucide:trees" class="h-4 w-4" /><Icon name="lucide:castle" class="h-4 w-4" /><Icon name="lucide:scroll-text" class="h-4 w-4" />
    </aside>

    <!-- Approved hero: intentionally left unchanged. -->
    <section class="relative mx-auto max-w-7xl px-4 pb-14 pt-12 xl:pl-28 xl:pr-8 xl:pt-16">
      <div class="grid items-center gap-10 xl:grid-cols-[1.08fr_.92fr] xl:gap-14"><div class="relative z-10"><p class="inline-flex items-center gap-2 border border-nav-light/60 bg-card/80 px-3 py-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-nav-light shadow-sm"><Icon name="lucide:flame" class="h-3.5 w-3.5" /> {hero.badge}</p><h1 class="mt-6 max-w-3xl font-serif text-5xl font-bold leading-[.98] tracking-tight text-foreground sm:text-6xl lg:text-[4.25rem]">{hero.title} <span class="text-nav-light">Wiki &amp; Guides</span></h1><div class="mt-6 h-px w-28 bg-nav-light/75"></div><p class="mt-6 max-w-xl text-base leading-7 text-muted-foreground sm:text-lg">{hero.description}</p><div class="mt-8 flex flex-wrap gap-4"><a href={localizePath('/guides', locale)} class="inline-flex items-center gap-2 border border-nav-light bg-nav px-5 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white shadow-[0_5px_0_hsl(var(--background)/.45)] transition hover:-translate-y-0.5 hover:bg-nav-light hover:text-background"><Icon name="lucide:map" class="h-4 w-4" /> Browse guide directory</a><a href={localizePath(hero.ctaSecondaryHref, locale)} class="inline-flex items-center gap-2 border border-border bg-card/80 px-5 py-3 text-sm font-bold uppercase tracking-[0.12em] text-foreground transition hover:border-nav-light hover:text-nav-light">{hero.ctaSecondary} <Icon name="lucide:arrow-up-right" class="h-4 w-4" /></a></div></div><div class="archive-frame relative mx-auto w-full max-w-[34rem] p-2 sm:p-3"><div class="relative aspect-[4/3] overflow-hidden border border-nav-light/35 bg-card"><img src="/images/settlement.jpg" alt="Hearth and Hamlet settlement" class="h-full w-full object-cover" loading="eager" /><div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-background/90 via-background/30 to-transparent p-5 pt-16"><p class="font-serif text-2xl font-bold text-white">Build a kingdom, one choice at a time.</p></div></div></div></div>
    </section>

    <section class="home-section mx-auto max-w-7xl px-4 xl:pl-28 xl:pr-8"><div class="home-overview-frame"><div class="home-overview-copy"><p class="home-eyebrow">Hearth and Hamlet at a glance</p><h2>What is Hearth and Hamlet?</h2><p>Hearth and Hamlet is a medieval pixel citybuilder about starting small, shaping a settlement through careful choices, and turning an exposed frontier into a lasting kingdom. Follow practical guides for workers, resources, buildings, research, magic, and current release details.</p><a href={localizePath('/game-overview', locale)}>Read game overview <Icon name="lucide:arrow-right" class="h-4 w-4" /></a></div><dl class="home-fact-grid">{(home.gameStats ?? []).map((stat: any) => <div><Icon name={stat.icon} class="h-5 w-5" /><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}<div><Icon name="lucide:repeat-2" class="h-5 w-5" /><dt>Core loop</dt><dd>Gather · Build · Grow</dd></div><div><Icon name="lucide:book-open" class="h-5 w-5" /><dt>Guide type</dt><dd>Community wiki</dd></div></dl></div></section>

    <section class="home-section mx-auto max-w-7xl px-4 xl:pl-28 xl:pr-8"><div class="home-start-frame"><div class="home-start-heading"><Icon name="lucide:compass" class="h-6 w-6" /><div><p class="home-eyebrow">Start here</p><h2>{home.start.title}</h2></div></div><div class="home-start-routes">{home.start.cards.map((card: any) => <a href={localizePath(card.href, locale)}><Icon name={card.icon} class="h-5 w-5" /><strong>{card.title}</strong><span>{card.description}</span><Icon name="lucide:arrow-right" class="h-5 w-5" /></a>)}</div></div></section>

    <section class="home-section mx-auto max-w-7xl px-4 xl:pl-28 xl:pr-8"><div class="home-archive-title"><p class="home-eyebrow">Hearth and Hamlet</p><h2>Browse the settlement archive</h2><a href={localizePath('/guides', locale)}>All guides <Icon name="lucide:arrow-right" class="h-4 w-4" /></a></div><div class="home-archive-layout"><nav aria-label="Wiki topics" class="home-topic-list">{archiveTopics.map((topic, index) => <a href={localizePath(topic.href, locale)} class={index === 1 ? 'is-featured' : ''}><Icon name={topic.icon} class="h-5 w-5" /><span>{topic.title}</span><Icon name="lucide:arrow-right" class="h-4 w-4" /></a>)}</nav><article class="home-feature-story"><img src="/images/buildings.jpg" alt="Hearth and Hamlet building screen" loading="lazy" /><div><p class="home-eyebrow">Featured route</p><h3>Plan a thriving hamlet</h3><p>Learn how buildings, workers, and basic resource chains fit together before you commit to the next upgrade.</p><a href={localizePath('/buildings', locale)}>Open buildings directory <Icon name="lucide:arrow-right" class="h-4 w-4" /></a></div></article></div><div class="home-showcase-heading"><h2>Explore the hamlet</h2><p>Guides organised around the systems you will meet in play.</p></div><div class="home-showcase-grid">{showcaseCards.map((card) => <a href={localizePath(card.href, locale)} class="home-showcase-card"><img src={card.image} alt={card.title} loading="lazy" /><div><h3>{card.title}</h3><p>{card.description}</p><span>Open guide <Icon name="lucide:arrow-up-right" class="h-4 w-4" /></span></div></a>)}</div></section>

    <section class="home-section mx-auto grid max-w-7xl gap-6 px-4 xl:grid-cols-[1.25fr_.75fr] xl:pl-28 xl:pr-8"><div class="home-updates-frame"><div class="home-panel-heading"><div><p class="home-eyebrow">Recently updated</p><h2>{home.updates.title}</h2></div><a href={localizePath('/updates', locale)}>All updates <Icon name="lucide:arrow-right" class="h-4 w-4" /></a></div>{recent.map((item) => { const entryParts = parseEntryId(item.id); const category = entryParts?.category ?? 'guides'; const slug = entryParts?.slug ?? ''; return <a href={detailPath(category, slug, locale)} class="home-update-row"><Icon name="lucide:scroll-text" class="h-5 w-5" /><div><p>{category} · Updated {item.data.updated ?? item.data.date}</p><h3>{item.data.title}</h3></div><span>{item.data.description}</span><Icon name="lucide:arrow-right" class="h-5 w-5" /></a>; })}</div><aside class="home-video-frame"><p class="home-eyebrow">Community video</p><h2>See the settlement in motion</h2><p>Watch the official trailer before choosing the route you want to explore.</p><div class="mt-5 overflow-hidden border border-nav-light/35 p-2"><VideoSection compact videoId="OidnO9knPR8" title="Hearth and Hamlet trailer" /></div><a href={localizePath('/trailer', locale)}>Open trailer notes <Icon name="lucide:arrow-right" class="h-4 w-4" /></a></aside></section>

    <section class="home-section mx-auto max-w-7xl px-4 xl:pl-28 xl:pr-8"><div class="home-closing"><Icon name="lucide:flame" class="h-6 w-6" /><p class="home-eyebrow">Keep building</p><h2>{home.closingCta.title}</h2><p>{home.closingCta.description}</p><a href={localizePath('/guides', locale)}>{home.closingCta.primary} <Icon name="lucide:arrow-right" class="h-4 w-4" /></a></div></section>
  </div>
</LocaleLayout>
